AI_PROXY_SECRET=dev-secret-change-me
APP_ENV=development

# Gemini (OpenAI-compatible). Paste key into AI_API_KEY or GEMINI_API_KEY.
AI_PROVIDER=gemini
AI_API_KEY=
GEMINI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=90
AI_ENABLED=true

OCR_LANGUAGES=vie+eng
# paddle = RapidOCR/PaddleOCR-ONNX (recommended); tesseract = legacy
OCR_ENGINE=paddle
MAX_FILE_BYTES=15728640
MAX_PDF_PAGES=20
CONFIDENCE_VERIFY_THRESHOLD=0.7

EXTRACT_MODE=free
RUN_OCR_WITH_VISION=false
VISION_FALLBACK_MIN_CONFIDENCE=0.75
VISION_FALLBACK_MIN_VALUES=8
